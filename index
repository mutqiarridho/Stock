<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<title>Cek Barang Belum Terdisplay</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap');

  :root{
    --navy:#0F3192;          /* biru logo Eigerindo */
    --navy-deep:#0A2470;
    --navy-ink:#0B1B4A;
    --navy-tint:#EEF2FB;
    --orange:#E46636;        /* oranye "MPI" */
    --orange-deep:#C9531F;
    --orange-tint:#FDF0EA;
    --ink:#16213D;
    --ink-soft:#5A6482;
    --paper:#F3F5FA;
    --panel:#FFFFFF;
    --line:#E1E6F0;
    --line-strong:#C8D0E0;
    --teal:#13806F;
    --teal-bg:#E3F4F0;
    /* alias untuk komponen lama */
    --amber:var(--orange);
    --amber-bg:var(--orange-tint);
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--paper);
    color:var(--ink);
    font-family:'Plus Jakarta Sans',system-ui,-apple-system,'Segoe UI',sans-serif;
    font-size:14.5px;
    line-height:1.5;
    min-height:100vh;display:flex;flex-direction:column;
  }
  main.wrap{flex:1;width:100%;}
  .wrap{max-width:1280px;margin:0 auto;padding:0 24px;}

  /* ---------- Credit strip ---------- */
  .credit{
    background:var(--navy-ink);
    color:#C9D3F0;
    font-size:12.5px;
  }
  .credit .wrap{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-top:7px;padding-bottom:7px;}
  .credit strong{color:#fff;font-weight:700;}
  .credit .dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--orange);margin-right:8px;vertical-align:middle;}
  .credit .ver{color:#8E9BC4;}

  /* ---------- Brand bar ---------- */
  .brandbar{
    background:var(--panel);border-bottom:1px solid var(--line);
    position:sticky;top:0;z-index:50;
    transition:box-shadow .2s ease;
  }
  .brandbar.scrolled{box-shadow:0 6px 18px rgba(11,27,74,.12);}
  .brandbar .wrap{display:flex;align-items:center;gap:18px;padding-top:14px;padding-bottom:14px;}
  .brandbar img{height:38px;width:auto;display:block;}
  .brandbar .sep{width:1px;height:30px;background:var(--line-strong);}
  .brandbar .app{font-weight:700;font-size:14px;color:var(--navy);line-height:1.2;}
  .brandbar .app small{display:block;font-weight:500;font-size:12px;color:var(--ink-soft);}
  .store-chip{
    margin-left:auto;display:none;align-items:center;gap:8px;
    background:var(--navy-tint);color:var(--navy);border-radius:999px;
    padding:6px 14px;font-size:12.5px;font-weight:600;
  }
  .store-chip.show{display:inline-flex;}
  .store-chip svg{flex:none;}

  /* ---------- Hero ---------- */
  .hero{
    background:var(--navy);
    color:#fff;
    position:relative;
    overflow:hidden;
  }
  .hero::after{
    /* garis oranye tipis di bawah hero, mengambil aksen "MPI" */
    content:"";position:absolute;left:0;right:0;bottom:0;height:4px;background:var(--orange);
  }
  .hero .wrap{display:grid;grid-template-columns:1.05fr 1fr;gap:36px;align-items:center;padding-top:38px;padding-bottom:44px;}
  .hero h1{font-size:34px;font-weight:800;letter-spacing:-0.02em;line-height:1.15;margin:0 0 12px;}
  .hero p{margin:0;color:#D3DBF3;font-size:15px;max-width:520px;}
  .hero p strong{color:#fff;}
  .flow{display:flex;align-items:center;gap:10px;margin-top:20px;flex-wrap:wrap;font-size:13px;font-weight:600;}
  .flow span{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.18);border-radius:6px;padding:5px 11px;}
  .flow span.miss{background:var(--orange);border-color:var(--orange);}
  .flow i{font-style:normal;color:#9FB0E3;}

  /* ---------- Dropzone ---------- */
  .dropzone{
    background:var(--panel);
    color:var(--ink);
    border:2px dashed var(--line-strong);
    border-radius:12px;
    padding:30px 22px;
    text-align:center;
    cursor:pointer;
    transition:border-color .15s ease, background .15s ease;
  }
  .dropzone:hover, .dropzone.drag{border-color:var(--orange);background:var(--orange-tint);}
  .dropzone:focus-visible{outline:3px solid var(--orange);outline-offset:3px;}
  .dropzone input{display:none;}
  .dz-icon{
    width:52px;height:52px;border-radius:50%;margin:0 auto 12px;
    display:flex;align-items:center;justify-content:center;
    background:var(--navy-tint);color:var(--navy);
  }
  .dropzone:hover .dz-icon, .dropzone.drag .dz-icon{background:var(--orange);color:#fff;}
  .dz-title{font-weight:700;font-size:15.5px;margin-bottom:4px;}
  .dz-sub{color:var(--ink-soft);font-size:12.5px;max-width:380px;margin:0 auto;}

  main.wrap{padding-top:26px;padding-bottom:40px;}

  .filename-bar{
    display:none;align-items:center;justify-content:space-between;
    background:var(--panel);border:1px solid var(--line);border-left:4px solid var(--navy);
    border-radius:8px;padding:11px 16px;margin-bottom:20px;font-size:13px;
  }
  .filename-bar.show{display:flex;}
  .filename-bar .fname{font-family:'JetBrains Mono',monospace;color:var(--navy);font-weight:600;}
  .filename-bar button{
    border:1px solid var(--line-strong);background:var(--panel);color:var(--ink);cursor:pointer;
    font-size:12.5px;font-weight:600;border-radius:6px;padding:5px 12px;font-family:inherit;
  }
  .filename-bar button:hover{border-color:var(--navy);color:var(--navy);}

  .error-box{
    display:none;background:#FDECEB;border:1px solid #EDB7AF;border-left:4px solid #C0392B;color:#8A2F22;
    border-radius:8px;padding:14px 16px;margin-bottom:20px;font-size:13.5px;
  }
  .error-box.show{display:block;}
  .error-box strong{display:block;margin-bottom:4px;}


  /* ---------- Semangat display ---------- */
  .spirit{
    display:grid;grid-template-columns:auto 1fr;gap:18px;align-items:start;
    background:var(--panel);border:1px solid var(--line);border-left:5px solid var(--orange);
    border-radius:10px;padding:20px 22px;margin-bottom:22px;
  }
  .spirit-icon{
    width:46px;height:46px;border-radius:12px;background:var(--orange-tint);color:var(--orange);
    display:flex;align-items:center;justify-content:center;
  }
  .spirit h3{margin:0 0 6px;font-size:18px;font-weight:800;color:var(--navy-ink);letter-spacing:-0.01em;}
  .spirit p{margin:0;color:var(--ink-soft);font-size:14px;max-width:760px;}
  .spirit-points{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:14px;}
  .spirit-points div{background:var(--navy-tint);border-radius:8px;padding:10px 12px;font-size:13px;color:var(--ink);}
  .spirit-points b{display:block;color:var(--navy);font-size:13.5px;margin-bottom:2px;}

  .coverage{
    background:var(--navy-ink);color:#fff;border-radius:12px;
    padding:20px 22px;margin-bottom:16px;
    display:grid;grid-template-columns:auto 1fr;gap:22px;align-items:center;
  }
  .coverage .pct{font-size:44px;font-weight:800;letter-spacing:-0.03em;line-height:1;}
  .coverage .pct small{display:block;font-size:12px;font-weight:600;color:#9FB0E3;letter-spacing:0;margin-top:6px;}
  .coverage .msg{font-size:15.5px;font-weight:700;margin-bottom:4px;}
  .coverage .msg-sub{font-size:13px;color:#C9D3F0;margin-bottom:12px;}
  .coverage .msg-sub b{color:#fff;}
  .bar{height:12px;background:rgba(255,255,255,.12);border-radius:999px;overflow:hidden;position:relative;}
  .bar-fill{height:100%;background:var(--orange);border-radius:999px;width:0;transition:width .8s ease;}
  .coverage.done .bar-fill{background:#2BB673;}
  .bar{overflow:visible;}
  .bar-fill{position:relative;z-index:1;}
  .bar-mark{
    position:absolute;top:-4px;bottom:-4px;width:3px;margin-left:-1.5px;border-radius:2px;
    background:#fff;z-index:2;box-shadow:0 0 0 2px var(--navy-ink);
  }
  .bar-target{position:relative;height:18px;font-size:11.5px;color:#9FB0E3;margin-top:6px;font-weight:600;}
  .bar-target span{position:absolute;top:0;white-space:nowrap;}
  .bar-target .t0{left:0;}
  .bar-target .t95{transform:translateX(-50%);color:#fff;}
  .bar-target .t100{right:0;}
  .coverage.done .bar-target .t95{color:#7FE0AE;}

  .exclude-note{
    display:none;align-items:flex-start;gap:10px;
    background:var(--navy-tint);border:1px solid #D3DCF3;border-radius:8px;
    padding:10px 14px;margin-bottom:16px;font-size:13px;color:var(--ink);
  }
  .exclude-note.show{display:flex;}
  .exclude-note svg{flex:none;color:var(--navy);margin-top:2px;}
  .exclude-note b{color:var(--navy);}
  .exclude-note .ex-list{color:var(--ink-soft);}

  /* ---------- Stats ---------- */
  .stat-row{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:26px;}
  .stat{
    background:var(--panel);border:1px solid var(--line);border-radius:10px;
    padding:16px 18px;position:relative;
  }
  .stat .num{font-size:30px;font-weight:800;letter-spacing:-0.02em;color:var(--navy);line-height:1.1;}
  .stat .lbl{color:var(--ink-soft);font-size:12.5px;font-weight:500;margin-top:4px;}
  .stat.ok .num{color:var(--teal);}
  .stat.flag{background:var(--orange);border-color:var(--orange);color:#fff;}
  .stat.flag .num{color:#fff;}
  .stat.flag .lbl{color:#FFE3D6;font-weight:600;}

  /* ---------- Toolbar ---------- */
  .toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px;flex-wrap:wrap;}
  .toolbar h2{font-size:18px;font-weight:800;margin:0;color:var(--navy-ink);letter-spacing:-0.01em;}
  .toolbar .actions{display:flex;gap:8px;align-items:center;}
  .search-input{
    border:1px solid var(--line-strong);border-radius:8px;padding:8px 12px;
    font-family:inherit;font-size:13px;width:260px;background:var(--panel);color:var(--ink);
  }
  .search-input:focus{outline:none;border-color:var(--navy);box-shadow:0 0 0 3px var(--navy-tint);}
  .btn{
    border:1px solid var(--navy);background:var(--navy);color:#fff;
    padding:8px 16px;border-radius:8px;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit;
  }
  .btn:hover{background:var(--navy-deep);border-color:var(--navy-deep);}
  .btn:focus-visible{outline:3px solid var(--orange);outline-offset:2px;}
  .btn[disabled]{opacity:.4;cursor:not-allowed;}
  .btn.ghost{background:transparent;color:var(--navy);border-color:var(--line-strong);}
  .btn.ghost:hover{background:var(--navy-tint);border-color:var(--navy);}

  /* ---------- Filter bar ---------- */
  .filter-bar{
    display:flex;flex-wrap:wrap;align-items:flex-end;gap:12px;
    background:var(--panel);border:1px solid var(--line);border-radius:10px;
    padding:14px 16px;margin-bottom:14px;
  }
  .ms{position:relative;display:flex;flex-direction:column;gap:5px;}
  .ms-label{font-size:12px;color:var(--ink-soft);font-weight:700;}
  .ms-btn{
    display:flex;align-items:center;justify-content:space-between;gap:8px;
    border:1px solid var(--line-strong);border-radius:8px;padding:8px 12px;
    font-family:inherit;font-size:13px;background:var(--panel);color:var(--ink);
    width:220px;cursor:pointer;text-align:left;
  }
  .ms-btn:hover{border-color:var(--navy);}
  .ms-btn span.txt{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .ms-btn .chev{font-size:10px;color:var(--ink-soft);}
  .ms-btn:focus-visible{outline:3px solid var(--orange);outline-offset:1px;}
  .ms.active .ms-btn{border-color:var(--orange);background:var(--orange-tint);color:var(--orange-deep);font-weight:700;}
  .ms.active .ms-btn .chev{color:var(--orange-deep);}
  .ms-panel{
    display:none;position:absolute;top:100%;left:0;z-index:20;margin-top:6px;
    width:270px;background:var(--panel);border:1px solid var(--line-strong);border-radius:10px;
    box-shadow:0 12px 32px rgba(11,27,74,.16);overflow:hidden;
  }
  .ms.open .ms-panel{display:block;}
  .ms-search{
    width:calc(100% - 20px);margin:10px;border:1px solid var(--line);border-radius:6px;
    padding:7px 9px;font-size:13px;font-family:inherit;
  }
  .ms-search:focus{outline:none;border-color:var(--navy);}
  .ms-actions{display:flex;justify-content:space-between;padding:0 12px 8px;font-size:12px;}
  .ms-actions button{border:none;background:none;color:var(--navy);cursor:pointer;padding:0;font-size:12px;font-weight:700;font-family:inherit;}
  .ms-actions button[data-act="none"]{color:var(--orange-deep);}
  .ms-actions button:hover{text-decoration:underline;}
  .ms-list{max-height:260px;overflow-y:auto;border-top:1px solid var(--line);padding:4px 0;}
  .ms-item{display:flex;align-items:center;gap:9px;padding:7px 12px;font-size:13px;cursor:pointer;}
  .ms-item:hover{background:var(--navy-tint);}
  .ms-item input{accent-color:var(--orange);margin:0;width:15px;height:15px;cursor:pointer;}
  .ms-item .cnt{margin-left:auto;color:var(--ink-soft);font-family:'JetBrains Mono',monospace;font-size:11.5px;background:var(--paper);border-radius:4px;padding:1px 6px;}
  .ms-empty{padding:12px;color:var(--ink-soft);font-size:12.5px;}
  .filter-count{margin-left:auto;font-size:13px;color:var(--ink-soft);align-self:center;}
  .filter-count strong{color:var(--navy);}

  /* ---------- Table ---------- */
  .table-scroll{overflow-x:auto;border:1px solid var(--line);border-radius:10px;background:var(--panel);}
  table{width:100%;border-collapse:collapse;background:var(--panel);}
  thead th{
    text-align:left;font-size:12px;font-weight:700;color:var(--navy);
    padding:11px 12px;border-bottom:2px solid var(--navy);
    background:var(--navy-tint);cursor:pointer;user-select:none;white-space:nowrap;
  }
  thead th:hover{color:var(--orange-deep);}
  thead th .arrow{opacity:.45;margin-left:3px;font-size:10px;}
  tbody tr{border-bottom:1px solid var(--line);}
  tbody tr.main-row{cursor:pointer;}
  tbody tr:last-child{border-bottom:none;}
  tbody tr.main-row:hover{background:#F7F9FE;}
  tbody td{padding:10px 12px;vertical-align:top;}
  td.mono, .mono{font-family:'JetBrains Mono',monospace;font-size:12.5px;}
  td.num-cell{font-family:'JetBrains Mono',monospace;text-align:right;font-weight:600;}
  .name-cell{min-width:260px;max-width:340px;font-weight:600;}
  .mc-cell{font-size:12.5px;white-space:nowrap;color:var(--ink-soft);}
  .caret{display:inline-block;width:14px;color:var(--orange);transition:transform .12s ease;}
  .caret.open{transform:rotate(90deg);}

  .detail-row{display:none;background:#F8FAFE;}
  .detail-row.open{display:table-row;}
  .detail-row td{padding:0;}
  .detail-inner{padding:6px 12px 14px 34px;}
  .detail-inner table{border:1px solid var(--line);border-radius:6px;}
  .detail-inner thead th{background:#fff;font-size:11px;border-bottom:1px solid var(--line-strong);color:var(--ink-soft);cursor:default;}
  .detail-inner tbody td{padding:7px 10px;font-size:12.5px;}

  .empty-state{
    text-align:center;padding:50px 20px;color:var(--ink-soft);
    background:var(--panel);border:1px solid var(--line);border-radius:10px;
  }
  .empty-state .big{font-size:16px;color:var(--navy);font-weight:700;margin-bottom:4px;}

  footer{border-top:1px solid var(--line);background:var(--panel);color:var(--ink-soft);font-size:12px;}
  footer .wrap{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;padding-top:16px;padding-bottom:18px;}
  footer strong{color:var(--navy);}

  @media (max-width:860px){
    .hero .wrap{grid-template-columns:1fr;gap:24px;padding-top:28px;padding-bottom:34px;}
    .hero h1{font-size:27px;}
  }
  @media (max-width:640px){
    .wrap{padding:0 16px;}
    .stat-row{grid-template-columns:repeat(2,1fr);}
    .spirit{grid-template-columns:1fr;}
    .spirit-points{grid-template-columns:1fr;}
    .coverage{grid-template-columns:1fr;gap:12px;}
    .toolbar{flex-direction:column;align-items:stretch;}
    .search-input{width:100%;}
    .ms, .ms-btn, .ms-panel{width:100%;}
    .filter-count{margin-left:0;}
    .brandbar .sep, .brandbar .app{display:none;}
    .credit .ver{display:none;}
  }
  @media (prefers-reduced-motion:reduce){*{transition:none !important;}}
</style>
</head>
<body>

<div class="credit">
  <div class="wrap">
    <span><span class="dot"></span>Tools ini dibuat oleh <strong>Fany Dzikri Hakim</strong></span>
    <span class="ver">PT. Eigerindo MPI &middot; Stock Display Check</span>
  </div>
</div>

<div class="brandbar">
  <div class="wrap">
    <img src="data:image/png;base64," alt="Eigerindo MPI">
    <span class="sep"></span>
    <span class="app">Stock Display Check<small>Audit zone Warehouse vs Sales Area</small></span>
    <span class="store-chip" id="storeChip">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l1.5-5h15L21 9"/><path d="M4 9v11h16V9"/><path d="M9 20v-6h6v6"/></svg>
      <span id="storeName"></span>
    </span>
  </div>
</div>

<section class="hero">
  <div class="wrap">
    <div>
      <h1>Cek Barang Belum Terdisplay</h1>
      <p>Upload export stock by bin. Tools ini mencari Generic Code yang stoknya ada di zone <strong>Warehouse</strong> tapi belum muncul di <strong>Selling area</strong> (zone Sales Area atau bin berawalan S), supaya tim toko tahu barang mana yang perlu segera dipajang.</p>
      <div class="flow"><span>Warehouse</span><i>tanpa</i><span>Selling area</span><i>=</i><span class="miss">Belum terdisplay</span></div>
    </div>
    <div class="dropzone" id="dropzone" tabindex="0" role="button" aria-label="Pilih file export stock">
      <input type="file" id="fileInput" accept=".xlsx,.xls,.csv">
      <div class="dz-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4"/><path d="M7 9l5-5 5 5"/><path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"/></svg>
      </div>
      <div class="dz-title">Klik untuk pilih file, atau drag &amp; drop di sini</div>
      <div class="dz-sub">Format .xlsx, .xls, atau .csv. Kolom wajib: Generic Code dan Zone Code. Artikel berawalan 98 &amp; 81 (bukan barang jual) otomatis dikecualikan.</div>
    </div>
  </div>
</section>

<main class="wrap">

  <section class="spirit">
    <div class="spirit-icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l6-6 4 4 8-8"/><path d="M15 7h6v6"/></svg>
    </div>
    <div>
      <h3>Barang yang tidak terlihat, tidak akan terjual.</h3>
      <p>Setiap generic yang masih tersimpan di gudang adalah peluang penjualan yang belum kita ambil. Pelanggan hanya bisa memilih apa yang mereka lihat di area penjualan, jadi pastikan semua generic punya wakil di display. Satu artikel yang naik ke rak hari ini bisa jadi transaksi berikutnya.</p>
      <div class="spirit-points">
        <div><b>Pilihan lebih lengkap</b>Variasi model dan warna yang lengkap membuat pelanggan betah dan lebih yakin membeli.</div>
        <div><b>Stok bergerak, sales naik</b>Barang yang terpajang berputar lebih cepat dibanding yang menunggu di gudang.</div>
        <div><b>Target minimal 95% terdisplay</b>Cek rutin, pajang segera, dan jaga display di atas 95% supaya toko kita jadi etalase terbaik Eiger.</div>
      </div>
    </div>
  </section>

  <div class="filename-bar" id="filenameBar">
    <span>File aktif: <span class="fname" id="fname"></span></span>
    <button id="clearBtn">ganti file</button>
  </div>

  <div class="error-box" id="errorBox">
    <strong id="errorTitle">Gagal membaca file</strong>
    <span id="errorMsg"></span>
  </div>

  <div id="resultsArea" style="display:none;">

    <div class="exclude-note" id="excludeNote">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
      <span id="excludeText"></span>
    </div>

    <div class="coverage" id="coverage">
      <div class="pct"><span id="covPct">0%</span><small>generic terdisplay</small></div>
      <div>
        <div class="msg" id="covMsg"></div>
        <div class="msg-sub" id="covSub"></div>
        <div class="bar">
          <div class="bar-fill" id="covBar"></div>
          <div class="bar-mark" style="left:95%;" title="Target 95%"></div>
        </div>
        <div class="bar-target">
          <span class="t0">0%</span>
          <span class="t95" style="left:95%;">Target 95%</span>
        </div>
      </div>
    </div>

    <div class="stat-row">
      <div class="stat"><div class="num" id="statTotal">0</div><div class="lbl">Total Generic Code</div></div>
      <div class="stat"><div class="num" id="statWh">0</div><div class="lbl">Ada di Warehouse</div></div>
      <div class="stat ok"><div class="num" id="statSa">0</div><div class="lbl">Ada di Selling Area</div></div>
      <div class="stat flag"><div class="num" id="statMissing">0</div><div class="lbl">Belum Terdisplay</div></div>
    </div>

    <div class="toolbar">
      <h2>Generic Code belum terdisplay</h2>
      <div class="actions">
        <input type="text" class="search-input" id="searchInput" placeholder="Cari generic code / nama SKU / MC...">
        <button class="btn" id="exportBtn">Export ke Excel</button>
      </div>
    </div>

    <div class="filter-bar">
      <div class="ms" data-level="mc2"></div>
      <div class="ms" data-level="mc3"></div>
      <div class="ms" data-level="mc4"></div>
      <button class="btn ghost" id="resetFilterBtn">Reset filter</button>
      <div class="filter-count" id="filterCount"></div>
    </div>

    <div id="tableWrap"></div>

  </div>

</main>

<footer>
  <div class="wrap">
    <span>Dibuat oleh <strong>Fany Dzikri Hakim</strong> untuk tim toko PT. Eigerindo MPI.</span>
    <span>Semua perhitungan berjalan di browser. File tidak diunggah ke server mana pun.</span>
  </div>
</footer>

<script>
(function(){
  const dropzone = document.getElementById('dropzone');
  const fileInput = document.getElementById('fileInput');
  const filenameBar = document.getElementById('filenameBar');
  const fnameEl = document.getElementById('fname');
  const clearBtn = document.getElementById('clearBtn');
  const errorBox = document.getElementById('errorBox');
  const errorMsg = document.getElementById('errorMsg');
  const resultsArea = document.getElementById('resultsArea');
  const tableWrap = document.getElementById('tableWrap');
  const searchInput = document.getElementById('searchInput');
  const exportBtn = document.getElementById('exportBtn');
  const EXCLUDE_PREFIXES = ['98', '81']; // artikel bukan barang jual
  // Bin Selling area: kode bin berawalan S + huruf + "-" (SA-, SB-, SH-, ...). "Staging Bin" tidak termasuk.
  const isSellingBin = (bin) => /^S[A-Z]-/i.test(String(bin ?? '').trim());
  const LEVELS = ['mc2','mc3','mc4'];
  const LEVEL_LABEL = {mc2:'MC LV 2', mc3:'MC LV 3', mc4:'MC LV 4'};
  const selected = {mc2:new Set(), mc3:new Set(), mc4:new Set()};
  const msEls = {};
  const resetFilterBtn = document.getElementById('resetFilterBtn');
  const filterCount = document.getElementById('filterCount');

  let summaryRows = [];      // {genericCode, sampleName, skuCount, totalQty, binCodes, zonesFound}
  let detailByGeneric = {};  // genericCode -> array of raw rows (full column set)
  let allColumns = [];
  let sortState = {key:'totalQty', dir:'desc'};
  let openRows = new Set();

  function showError(title, msg){
    document.getElementById('errorTitle').textContent = title;
    errorMsg.textContent = msg;
    errorBox.classList.add('show');
    resultsArea.style.display = 'none';
  }
  function clearError(){
    errorBox.classList.remove('show');
  }

  function findKey(headerMap, candidates){
    for(const c of candidates){
      const k = c.toLowerCase().replace(/[\s_]/g,'');
      if(headerMap[k]) return headerMap[k];
    }
    return null;
  }

  function normalizeZone(z){
    return String(z || '').trim().toLowerCase();
  }

  function processRows(rows){
    if(!rows.length){
      showError('File kosong', 'Tidak ada baris data yang terbaca dari sheet pertama.');
      return;
    }
    const headerMap = {};
    Object.keys(rows[0]).forEach(h => {
      headerMap[String(h).toLowerCase().replace(/[\s_]/g,'')] = h;
    });

    const genericKey = findKey(headerMap, ['Generic Code','GenericCode']);
    const zoneKey = findKey(headerMap, ['Zone Code','ZoneCode','Zone']);
    const skuCodeKey = findKey(headerMap, ['SKU Code','SKUCode']);
    const skuNameKey = findKey(headerMap, ['SKU Name','SKUName']);
    const binKey = findKey(headerMap, ['Bin Code','BinCode']);
    const qtyKey = findKey(headerMap, ['Total Qty','TotalQty','Qty']);
    const mc2Key = findKey(headerMap, ['MC LV 2','MCLV2','MC Level 2']);
    const mc3Key = findKey(headerMap, ['MC LV 3','MCLV3','MC Level 3']);
    const mc4Key = findKey(headerMap, ['MC LV 4','MCLV4','MC Level 4']);

    if(!genericKey || !zoneKey){
      showError(
        'Kolom wajib tidak ditemukan',
        'Tool ini butuh kolom "Generic Code" dan "Zone Code" di sheet pertama. Kolom yang terbaca: ' + Object.keys(rows[0]).join(', ')
      );
      return;
    }

    clearError();

    // Tampilkan nama toko di header (dari kolom Location)
    const locKey = findKey(headerMap, ['Location','Store','Lokasi']);
    const locVal = locKey ? String(rows.find(r => String(r[locKey]).trim())?.[locKey] ?? '').trim() : '';
    document.getElementById('storeName').textContent = locVal.replace(/\s+/g,' ');
    document.getElementById('storeChip').classList.toggle('show', !!locVal);

    // ===== Kecualikan artikel bukan barang jual (kode awalan 98 & 81) =====
    // contoh: paper bag, shopping bag, voucher, stuffing, packing
    const isExcluded = (r) => {
      const codes = [skuCodeKey ? r[skuCodeKey] : '', r[genericKey]].map(v => String(v ?? '').trim());
      return codes.some(c => EXCLUDE_PREFIXES.some(px => c.startsWith(px)));
    };
    const excludedRows = rows.filter(isExcluded);
    rows = rows.filter(r => !isExcluded(r));
    const exNote = document.getElementById('excludeNote');
    document.getElementById('excludeText').innerHTML = '';
    if(excludedRows.length){
      const exSkus = new Set(excludedRows.map(r => String(skuCodeKey ? r[skuCodeKey] : r[genericKey]).trim()));
      const exNames = [...new Set(excludedRows.map(r => skuNameKey ? String(r[skuNameKey]).split(',')[0].trim() : ''))].filter(Boolean);
      const sample = exNames.slice(0, 4).join(', ') + (exNames.length > 4 ? `, dan ${exNames.length - 4} lainnya` : '');
      document.getElementById('excludeText').innerHTML =
        `<b>${exSkus.size} artikel bukan barang jual dikecualikan</b> (${excludedRows.length} baris, kode awalan ${EXCLUDE_PREFIXES.join(' &amp; ')}) dan tidak dihitung di hasil maupun target. <span class="ex-list">${escapeHtml(sample)}</span>`;
      exNote.classList.add('show');
    } else {
      exNote.classList.remove('show');
    }

    const warehouseSet = new Set();
    const salesAreaSet = new Set();   // zone Sales Area + bin Selling area (S)
    const zoneSaSet = new Set();      // khusus zone Sales Area, untuk catatan
    const genericInfo = {}; // genericCode -> {sampleName, skus:Set, totalQty, bins:Set, rows:[]}

    rows.forEach(r => {
      const gc = String(r[genericKey] ?? '').trim();
      if(!gc) return;
      const zoneNorm = normalizeZone(r[zoneKey]);

      if(zoneNorm === 'warehouse') warehouseSet.add(gc);
      // Terhitung terdisplay bila zone-nya Sales Area ATAU bin-nya bin Selling area (awalan S, mis. SA-, SB-, SH-)
      if(zoneNorm === 'sales area'){ salesAreaSet.add(gc); zoneSaSet.add(gc); }
      else if(binKey && isSellingBin(r[binKey])){ salesAreaSet.add(gc); }

      if(!genericInfo[gc]){
        genericInfo[gc] = {sampleName:null, mc2:'', mc3:'', mc4:'', skus:new Set(), totalQty:0, bins:new Set(), rows:[]};
      }
      const info = genericInfo[gc];
      if(zoneNorm === 'warehouse'){
        if(!info.sampleName && skuNameKey) info.sampleName = r[skuNameKey];
        if(!info.mc2 && mc2Key && String(r[mc2Key]).trim()) info.mc2 = String(r[mc2Key]).trim();
        if(!info.mc3 && mc3Key && String(r[mc3Key]).trim()) info.mc3 = String(r[mc3Key]).trim();
        if(!info.mc4 && mc4Key && String(r[mc4Key]).trim()) info.mc4 = String(r[mc4Key]).trim();
        if(skuCodeKey) info.skus.add(r[skuCodeKey]);
        if(binKey && r[binKey]) info.bins.add(r[binKey]);
        if(qtyKey){
          const q = parseFloat(r[qtyKey]);
          if(!isNaN(q)) info.totalQty += q;
        }
        info.rows.push(r);
      }
    });

    const allGeneric = new Set([...warehouseSet, ...salesAreaSet]);
    // also count generic codes that might only appear in other zones, for the "total" stat
    rows.forEach(r => {
      const gc = String(r[genericKey] ?? '').trim();
      if(gc) allGeneric.add(gc);
    });

    const missing = [...warehouseSet].filter(gc => !salesAreaSet.has(gc));
    const viaSellingBin = [...warehouseSet].filter(gc => salesAreaSet.has(gc) && !zoneSaSet.has(gc)).length;
    if(viaSellingBin){
      document.getElementById('excludeText').innerHTML +=
        (exNote.classList.contains('show') ? '<br>' : '') +
        `<b>${viaSellingBin} generic dianggap sudah terdisplay</b> karena berada di bin Selling area (awalan S, mis. SA-BO / SA-TR) walau zone-nya bukan Sales Area.`;
      exNote.classList.add('show');
    }

    summaryRows = missing.map(gc => {
      const info = genericInfo[gc];
      return {
        genericCode: gc,
        sampleName: info.sampleName || '(nama tidak tersedia)',
        mc2: info.mc2 || '-',
        mc3: info.mc3 || '-',
        mc4: info.mc4 || '-',
        skuCount: info.skus.size || info.rows.length,
        totalQty: info.totalQty,
        binCodes: [...info.bins].sort().join(', '),
      };
    });
    detailByGeneric = {};
    missing.forEach(gc => { detailByGeneric[gc] = genericInfo[gc].rows; });
    allColumns = skuCodeKey || skuNameKey || binKey || qtyKey
      ? [skuCodeKey, skuNameKey, mc2Key, mc3Key, mc4Key, binKey, qtyKey].filter(Boolean)
      : Object.keys(rows[0]);

    document.getElementById('statTotal').textContent = allGeneric.size;
    document.getElementById('statWh').textContent = warehouseSet.size;
    document.getElementById('statSa').textContent = salesAreaSet.size;
    document.getElementById('statMissing').textContent = missing.length;
    updateCoverage(warehouseSet.size, missing.length, missing.reduce((a,gc) => a + genericInfo[gc].totalQty, 0));

    openRows = new Set();
    sortState = {key:'totalQty', dir:'desc'};
    LEVELS.forEach(l => selected[l].clear());
    refreshFilterOptions();
    resultsArea.style.display = 'block';
    renderTable();
  }

  // ===== Progres display + pesan semangat =====
  const DISPLAY_TARGET = 95; // target minimal % generic terdisplay

  function updateCoverage(whCount, missingCount, missingQty){
    const displayed = whCount - missingCount;
    const pct = whCount ? (displayed / whCount) * 100 : 100;
    const pctTxt = (pct === 100 ? '100' : pct.toFixed(1).replace('.', ',')) + '%';
    // berapa generic lagi yang harus dipajang supaya target tercapai
    const need = Math.max(0, Math.ceil(whCount * DISPLAY_TARGET / 100 - 1e-9) - displayed);
    const reached = pct >= DISPLAY_TARGET;
    const qtyTxt = missingQty.toLocaleString('id-ID');

    let msg, sub;
    if(missingCount === 0){
      msg = 'Sempurna! 100% generic terdisplay, melampaui target 95%. Pertahankan, tim!';
      sub = 'Semua generic yang ada di gudang sudah punya wakil di Sales Area. Peluang sales terbuka penuh.';
    } else if(reached){
      msg = 'Target 95% tercapai! Mantap, tim. Pertahankan dan terus lengkapi display.';
      sub = `<b>${displayed}</b> dari <b>${whCount}</b> generic di gudang sudah terdisplay. Sisa <b>${missingCount} generic</b> (<b>${qtyTxt} pcs</b>) masih bisa jadi tambahan sales kalau ikut dipajang.`;
    } else if(pct >= 90){
      msg = `Tinggal sedikit lagi! Pajang ${need} generic lagi dan target 95% tercapai.`;
      sub = `<b>${displayed}</b> dari <b>${whCount}</b> generic di gudang sudah terdisplay. Masih ada <b>${missingCount} generic</b> (<b>${qtyTxt} pcs</b>) yang menunggu dipajang.`;
    } else if(pct >= 80){
      msg = `Sudah di jalur yang benar. Butuh ${need} generic lagi untuk mencapai target 95%, ayo kejar!`;
      sub = `<b>${displayed}</b> dari <b>${whCount}</b> generic di gudang sudah terdisplay. Masih ada <b>${missingCount} generic</b> (<b>${qtyTxt} pcs</b>) yang menunggu dipajang. Mulai dari qty terbesar supaya dampaknya ke sales paling terasa.`;
    } else {
      msg = `Masih banyak peluang sales tertahan di gudang. Butuh ${need} generic lagi untuk mencapai target 95%.`;
      sub = `<b>${displayed}</b> dari <b>${whCount}</b> generic di gudang sudah terdisplay. Masih ada <b>${missingCount} generic</b> (<b>${qtyTxt} pcs</b>) yang menunggu dipajang. Yuk bagi tugas per MC dan mulai dari qty terbesar!`;
    }

    document.getElementById('covPct').textContent = pctTxt;
    document.getElementById('covMsg').textContent = msg;
    document.getElementById('covSub').innerHTML = sub;
    document.getElementById('coverage').classList.toggle('done', reached);
    const bar = document.getElementById('covBar');
    bar.style.width = '0';
    setTimeout(() => { bar.style.width = pct + '%'; }, 60);
  }

  function sortRows(rows){
    const {key, dir} = sortState;
    const mult = dir === 'asc' ? 1 : -1;
    return [...rows].sort((a,b) => {
      let av = a[key], bv = b[key];
      if(typeof av === 'string') av = av.toLowerCase();
      if(typeof bv === 'string') bv = bv.toLowerCase();
      if(av < bv) return -1 * mult;
      if(av > bv) return 1 * mult;
      return 0;
    });
  }

  // ===== Filter MC (checklist, bisa pilih beberapa) =====
  // Pilihan bertingkat: LV 3 mengikuti centang di LV 2, LV 4 mengikuti LV 2 + LV 3.
  function matchLevels(r, upto){
    for(const l of LEVELS){
      if(l === upto) break;
      if(selected[l].size && !selected[l].has(r[l])) return false;
    }
    return true;
  }
  function optionsFor(level){
    const counts = {};
    summaryRows.forEach(r => {
      if(matchLevels(r, level)) counts[r[level]] = (counts[r[level]] || 0) + 1;
    });
    return Object.keys(counts).sort((a,b) => a.localeCompare(b)).map(v => ({value:v, count:counts[v]}));
  }

  function buildMultiSelect(el){
    const level = el.dataset.level;
    el.innerHTML = `
      <span class="ms-label">${LEVEL_LABEL[level]}</span>
      <button type="button" class="ms-btn" aria-haspopup="listbox" aria-expanded="false">
        <span class="txt">Semua</span><span class="chev">&#9662;</span>
      </button>
      <div class="ms-panel">
        <input type="text" class="ms-search" placeholder="Cari ${LEVEL_LABEL[level]}...">
        <div class="ms-actions">
          <button type="button" data-act="all">Pilih semua</button>
          <button type="button" data-act="none">Kosongkan</button>
        </div>
        <div class="ms-list"></div>
      </div>`;
    const btn = el.querySelector('.ms-btn');
    const search = el.querySelector('.ms-search');
    const list = el.querySelector('.ms-list');

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const willOpen = !el.classList.contains('open');
      Object.values(msEls).forEach(o => { o.classList.remove('open'); o.querySelector('.ms-btn').setAttribute('aria-expanded','false'); });
      if(willOpen){
        el.classList.add('open');
        btn.setAttribute('aria-expanded','true');
        search.value = '';
        renderList(level);
        search.focus();
      }
    });
    el.querySelector('.ms-panel').addEventListener('click', e => e.stopPropagation());
    search.addEventListener('input', () => renderList(level));
    el.querySelector('[data-act="all"]').addEventListener('click', () => {
      // centang semua yang sedang tampil (ikut hasil pencarian di dalam panel)
      visibleOptions(level).forEach(o => selected[level].add(o.value));
      onFilterChange(level);
    });
    el.querySelector('[data-act="none"]').addEventListener('click', () => {
      selected[level].clear();
      onFilterChange(level);
    });
    list.addEventListener('change', (e) => {
      const cb = e.target;
      if(cb.type !== 'checkbox') return;
      if(cb.checked) selected[level].add(cb.value); else selected[level].delete(cb.value);
      onFilterChange(level);
    });
    msEls[level] = el;
  }

  function visibleOptions(level){
    const q = msEls[level].querySelector('.ms-search').value.trim().toLowerCase();
    return optionsFor(level).filter(o => !q || o.value.toLowerCase().includes(q));
  }

  function renderList(level){
    const list = msEls[level].querySelector('.ms-list');
    const opts = visibleOptions(level);
    if(!opts.length){
      list.innerHTML = '<div class="ms-empty">Tidak ada pilihan.</div>';
      return;
    }
    list.innerHTML = opts.map(o => `
      <label class="ms-item">
        <input type="checkbox" value="${escapeAttr(o.value)}" ${selected[level].has(o.value) ? 'checked' : ''}>
        <span>${escapeHtml(o.value)}</span>
        <span class="cnt">${o.count}</span>
      </label>`).join('');
  }

  function updateButton(level){
    const el = msEls[level];
    const set = selected[level];
    const txt = el.querySelector('.ms-btn .txt');
    if(!set.size){ txt.textContent = 'Semua'; }
    else if(set.size === 1){ txt.textContent = [...set][0]; }
    else { txt.textContent = set.size + ' dipilih'; }
    el.querySelector('.ms-btn').title = set.size ? [...set].sort().join(', ') : 'Semua';
    el.classList.toggle('active', set.size > 0);
  }

  // Buang centang di level bawah yang sudah tidak tersedia setelah level atas berubah
  function refreshFilterOptions(){
    LEVELS.forEach(level => {
      const avail = new Set(optionsFor(level).map(o => o.value));
      [...selected[level]].forEach(v => { if(!avail.has(v)) selected[level].delete(v); });
      updateButton(level);
      if(msEls[level].classList.contains('open')) renderList(level);
    });
  }

  function onFilterChange(){
    openRows = new Set();
    refreshFilterOptions();
    renderTable();
  }

  document.querySelectorAll('.ms').forEach(buildMultiSelect);
  document.addEventListener('click', () => {
    Object.values(msEls).forEach(o => { o.classList.remove('open'); o.querySelector('.ms-btn').setAttribute('aria-expanded','false'); });
  });
  document.addEventListener('keydown', (e) => {
    if(e.key === 'Escape') Object.values(msEls).forEach(o => o.classList.remove('open'));
  });

  function getFilteredRows(){
    const q = searchInput.value.trim().toLowerCase();
    let rows = summaryRows.filter(r =>
      LEVELS.every(l => !selected[l].size || selected[l].has(r[l]))
    );
    if(q){
      rows = rows.filter(r =>
        r.genericCode.toLowerCase().includes(q) ||
        String(r.sampleName).toLowerCase().includes(q) ||
        [r.mc2, r.mc3, r.mc4].join(' ').toLowerCase().includes(q)
      );
    }
    return rows;
  }

  function renderTable(){
    let rows = getFilteredRows();
    const qtySum = rows.reduce((a,r) => a + r.totalQty, 0);
    filterCount.innerHTML = `Menampilkan <strong>${rows.length}</strong> dari ${summaryRows.length} generic &middot; qty <strong>${qtySum}</strong>`;
    rows = sortRows(rows);

    if(!rows.length){
      tableWrap.innerHTML = `<div class="empty-state">
        <div class="big">${summaryRows.length === 0 ? 'Semua barang sudah terdisplay, mantap! 🎉' : 'Tidak ada hasil untuk filter / pencarian ini'}</div>
        <div>${summaryRows.length === 0 ? 'Tidak ada generic yang tertahan di gudang. Display lengkap, peluang sales terbuka lebar.' : 'Coba ubah pilihan MC LV atau kata kunci, atau klik Reset filter.'}</div>
      </div>`;
      return;
    }

    const arrow = (key) => sortState.key === key ? `<span class="arrow">${sortState.dir === 'asc' ? '▲' : '▼'}</span>` : `<span class="arrow">↕</span>`;

    let html = `<div class="table-scroll"><table>
      <thead>
        <tr>
          <th style="width:24px;"></th>
          <th data-sort="genericCode">Generic Code ${arrow('genericCode')}</th>
          <th data-sort="sampleName">Contoh Nama SKU ${arrow('sampleName')}</th>
          <th data-sort="mc2">MC LV 2 ${arrow('mc2')}</th>
          <th data-sort="mc3">MC LV 3 ${arrow('mc3')}</th>
          <th data-sort="mc4">MC LV 4 ${arrow('mc4')}</th>
          <th data-sort="skuCount">Jml SKU ${arrow('skuCount')}</th>
          <th data-sort="totalQty">Qty Warehouse ${arrow('totalQty')}</th>
          <th data-sort="binCodes">Bin Code ${arrow('binCodes')}</th>
        </tr>
      </thead>
      <tbody>`;

    rows.forEach(r => {
      const isOpen = openRows.has(r.genericCode);
      html += `<tr class="main-row" data-gc="${escapeAttr(r.genericCode)}">
        <td><span class="caret ${isOpen ? 'open':''}">&#9656;</span></td>
        <td class="mono">${escapeHtml(r.genericCode)}</td>
        <td class="name-cell">${escapeHtml(r.sampleName)}</td>
        <td class="mc-cell">${escapeHtml(r.mc2)}</td>
        <td class="mc-cell">${escapeHtml(r.mc3)}</td>
        <td class="mc-cell">${escapeHtml(r.mc4)}</td>
        <td class="num-cell">${r.skuCount}</td>
        <td class="num-cell">${r.totalQty}</td>
        <td class="mono">${escapeHtml(r.binCodes)}</td>
      </tr>`;
      html += `<tr class="detail-row ${isOpen ? 'open':''}" data-detail-for="${escapeAttr(r.genericCode)}">
        <td colspan="9"><div class="detail-inner">${renderDetailTable(r.genericCode)}</div></td>
      </tr>`;
    });

    html += `</tbody></table></div>`;
    tableWrap.innerHTML = html;

    tableWrap.querySelectorAll('thead th[data-sort]').forEach(th => {
      th.addEventListener('click', () => {
        const key = th.getAttribute('data-sort');
        if(sortState.key === key){
          sortState.dir = sortState.dir === 'asc' ? 'desc' : 'asc';
        } else {
          sortState = {key, dir:'asc'};
        }
        renderTable();
      });
    });

    tableWrap.querySelectorAll('.main-row').forEach(tr => {
      tr.addEventListener('click', () => {
        const gc = tr.getAttribute('data-gc');
        if(openRows.has(gc)) openRows.delete(gc); else openRows.add(gc);
        renderTable();
      });
    });
  }

  function renderDetailTable(gc){
    const rows = detailByGeneric[gc] || [];
    if(!rows.length) return '<em>Tidak ada detail baris.</em>';
    const cols = allColumns.length ? allColumns : Object.keys(rows[0]);
    let html = '<table><thead><tr>' + cols.map(c => `<th>${escapeHtml(c)}</th>`).join('') + '</tr></thead><tbody>';
    rows.forEach(r => {
      html += '<tr>' + cols.map(c => `<td class="mono">${escapeHtml(r[c] ?? '')}</td>`).join('') + '</tr>';
    });
    html += '</tbody></table>';
    return html;
  }

  function escapeHtml(s){
    return String(s ?? '').replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
  }
  function escapeAttr(s){ return escapeHtml(s); }

  function handleFile(file){
    if(!file) return;
    clearError();
    fnameEl.textContent = file.name;
    filenameBar.classList.add('show');

    const reader = new FileReader();
    reader.onload = function(e){
      try{
        const data = new Uint8Array(e.target.result);
        const wb = XLSX.read(data, {type:'array'});
        const firstSheetName = wb.SheetNames[0];
        const sheet = wb.Sheets[firstSheetName];
        const rows = XLSX.utils.sheet_to_json(sheet, {defval:''});
        processRows(rows);
      }catch(err){
        showError('Gagal membaca file', 'Pastikan file berupa .xlsx, .xls, atau .csv yang valid. Detail teknis: ' + err.message);
      }
    };
    reader.onerror = function(){
      showError('Gagal membaca file', 'Terjadi kesalahan saat membaca file dari perangkat.');
    };
    reader.readAsArrayBuffer(file);
  }

  // Header logo tetap di atas saat scroll; beri bayangan begitu mulai menempel
  const brandbar = document.querySelector('.brandbar');
  const onScroll = () => brandbar.classList.toggle('scrolled', brandbar.getBoundingClientRect().top <= 0 && window.scrollY > 0);
  window.addEventListener('scroll', onScroll, {passive:true});
  onScroll();

  dropzone.addEventListener('click', () => fileInput.click());
  dropzone.addEventListener('keydown', (e) => {
    if(e.key === 'Enter' || e.key === ' '){ e.preventDefault(); fileInput.click(); }
  });
  fileInput.addEventListener('change', (e) => handleFile(e.target.files[0]));

  ['dragover'].forEach(evt => {
    dropzone.addEventListener(evt, (e) => { e.preventDefault(); dropzone.classList.add('drag'); });
  });
  ['dragleave','drop'].forEach(evt => {
    dropzone.addEventListener(evt, (e) => { e.preventDefault(); dropzone.classList.remove('drag'); });
  });
  dropzone.addEventListener('drop', (e) => {
    e.preventDefault();
    const file = e.dataTransfer.files[0];
    if(file) handleFile(file);
  });

  clearBtn.addEventListener('click', () => {
    fileInput.value = '';
    filenameBar.classList.remove('show');
    document.getElementById('storeChip').classList.remove('show');
    resultsArea.style.display = 'none';
    clearError();
    summaryRows = [];
    detailByGeneric = {};
  });

  searchInput.addEventListener('input', renderTable);

  resetFilterBtn.addEventListener('click', () => {
    LEVELS.forEach(l => selected[l].clear());
    searchInput.value = '';
    refreshFilterOptions();
    renderTable();
  });

  exportBtn.addEventListener('click', () => {
    const exportRows = getFilteredRows();
    if(!exportRows.length){
      alert('Tidak ada data untuk diexport.');
      return;
    }
    const wsSummaryData = exportRows.map(r => ({
      'Generic Code': r.genericCode,
      'Contoh Nama SKU': r.sampleName,
      'MC LV 2': r.mc2,
      'MC LV 3': r.mc3,
      'MC LV 4': r.mc4,
      'Jumlah SKU': r.skuCount,
      'Total Qty (Warehouse)': r.totalQty,
      'Bin Code': r.binCodes,
    }));
    const wsDetailData = [];
    exportRows.forEach(s => {
      (detailByGeneric[s.genericCode] || []).forEach(r => wsDetailData.push(r));
    });

    const wb = XLSX.utils.book_new();
    const ws1 = XLSX.utils.json_to_sheet(wsSummaryData);
    const ws2 = XLSX.utils.json_to_sheet(wsDetailData);
    XLSX.utils.book_append_sheet(wb, ws1, 'Ringkasan');
    XLSX.utils.book_append_sheet(wb, ws2, 'Detail SKU');
    const picked = LEVELS.flatMap(l => [...selected[l]]);
    const tag = (picked.length > 3 ? 'multi-MC' : picked.join('_')).replace(/[^\w-]+/g,'-');
    XLSX.writeFile(wb, 'Barang_Belum_Terdisplay' + (tag ? '_' + tag : '') + '.xlsx');
  });

})();
</script>
</body>
</html>
